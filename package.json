{
  "name": "sap-taskmanager",
  "version": "1.0.0",
  "description": "Welcome to your new CAP project.",
  "homepage": "https://github.com/masterchief-00/sap-taskmanager#readme",
  "bugs": {
    "url": "https://github.com/masterchief-00/sap-taskmanager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masterchief-00/sap-taskmanager.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch-taskmanager": "cds watch --open ns.taskmanager/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-employee": "cds watch --open ns.employee/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/taskdb.db"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "alice@company.com": {
            "roles": [
              "authenticated-user",
              "Employee"
            ],
            "tenant": "t1"
          },
          "bob@company.com": {
            "roles": [
              "authenticated-user",
              "Manager"
            ],
            "tenant": "t1"
          }
        }
      }
    }
  },
  "dependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds": "^9.9.1",
    "@sap/cds-dk": "^9.9.2",
    "@sap/cds-foss": "^5.0.2"
  },
  "workspaces": [
    "app/*"
  ],
  "devDependencies": {
    "cds-plugin-ui5": "^0.13.0"
  },
  "sapux": [
    "app/taskmanager",
    "app/employee"
  ]
}
